generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  AGENT
}

enum ListingPurpose {
  RENT
  SALE
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  COMING_SOON
  RENTED_SOLD
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VIEWING
  CLOSED
  SPAM
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  name           String
  passwordHash   String
  role           Role        @default(AGENT)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sessions       Session[]
  listings       Listing[]   @relation("AssignedListings")
  enquiries      Enquiry[]   @relation("AssignedEnquiries")
  auditEvents    AuditEvent[]
  importPreviews CsvImportPreview[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Listing {
  id                  String         @id @default(cuid())
  title               String
  slug                String         @unique
  description         String
  purpose             ListingPurpose @default(RENT)
  propertyType        String         @default("Apartment")
  price               Decimal        @db.Decimal(12, 2)
  paymentPeriod       String         @default("month")
  currency            String         @default("USD")
  address             String
  neighbourhood       String?
  city                String
  region              String
  postalCode          String?
  country             String         @default("United States")
  latitude            Decimal?       @db.Decimal(10, 7)
  longitude           Decimal?       @db.Decimal(10, 7)
  bedrooms            Int            @default(0)
  bathrooms           Decimal        @default(1) @db.Decimal(4, 1)
  floorArea           Decimal?       @db.Decimal(10, 2)
  areaUnit            String         @default("sq ft")
  furnished           String         @default("UNFURNISHED")
  amenities           String[]       @default([])
  utilities           String[]       @default([])
  availabilityDate    DateTime?
  status              ListingStatus  @default(DRAFT)
  featured            Boolean        @default(false)
  ownerName           String?
  ownerEmail          String?
  ownerPhone          String?
  displayOwnerContact Boolean        @default(false)
  viewingInstructions String?
  seoTitle            String?
  seoDescription      String?
  assignedToId        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignedTo          User?          @relation("AssignedListings", fields: [assignedToId], references: [id], onDelete: SetNull)
  photos              ListingPhoto[]
  enquiries           Enquiry[]

  @@index([status, purpose, createdAt])
  @@index([city, neighbourhood])
  @@index([price, bedrooms, bathrooms])
  @@index([assignedToId])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  url       String
  caption   String?
  altText   String
  position  Int      @default(0)
  cover     Boolean  @default(false)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

model Enquiry {
  id           String        @id @default(cuid())
  listingId    String?
  name         String
  email        String
  phone        String?
  message      String
  consent      Boolean
  status       EnquiryStatus @default(NEW)
  notes        String?
  assignedToId String?
  ipHash       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("AssignedEnquiries", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([assignedToId])
  @@index([ipHash, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SitePage {
  slug        String   @id
  title       String
  body        String   @db.Text
  metaTitle   String?
  metaDescription String?
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model CsvImportPreview {
  id        String   @id @default(cuid())
  userId    String
  rows      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
