# PostgreSQL provider connection strings. Use the pooled URL at runtime and
# the direct (non-pooling) URL for Prisma schema migrations and client generation.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random value (32+ bytes) for first-owner setup. Remove it
# from the deployment after the first owner account has been created.
SETUP_SECRET="replace-with-a-long-random-one-time-setup-secret"

# The canonical public origin, without a trailing slash.
SITE_URL="https://your-domain.example"

# Optional: Vercel Blob for listing photos.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace-with-your-token"

# Optional: Resend email notifications. Notifications are disabled unless all
# three variables are set and the site's contact email is configured.
RESEND_API_KEY="re_replace-with-your-resend-api-key"
RESEND_FROM="Apex Stay <listings@example.com>"
